# BotFather tokenini faqat shu faylning .env nusxasiga yozing.
BOT_TOKEN=
# Telegram raqamli user ID; bir nechtasi vergul bilan ajratiladi.
ADMIN_IDS=
# Ixtiyoriy. Docker'da standart DATA_DIR=/data; lokal ishga tushirishda ./data.
# DATA_DIR=./data
# DOWNLOAD_DIR=./downloads
# Worker soni bir vaqtdagi yuklashlar sonini belgilaydi.
WORKERS=2
MAX_FILE_MB=48
# 48 MB dan katta fayllar uchun --local rejimida ishlaydigan alohida Bot API serveri kerak.
# TELEGRAM_LOCAL_API_URL=http://127.0.0.1:8081
# MAX_FILE_MB=2000
# 0 = davomiylik cheklanmagan. 24 soatgacha sozlash mumkin.
MAX_DURATION_SECONDS=0
# Standart rejimda yuklash 180 s, yuborish 120 s. 48 MB dan katta limitda ikkalasi 1800 s.
# DOWNLOAD_TIMEOUT_SECONDS=180
# UPLOAD_TIMEOUT_SECONDS=120
# Faqat kerak bo'lsa, Netscape formatidagi cookies fayli yo'li.
COOKIES_FILE=
