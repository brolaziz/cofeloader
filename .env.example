# BotFather tokenini faqat shu faylning .env nusxasiga yozing.
BOT_TOKEN=
# Telegram raqamli user ID; bir nechtasi vergul bilan ajratiladi.
ADMIN_IDS=
# Ixtiyoriy. Docker'da standart DATA_DIR=/data; lokal ishga tushirishda ./data.
# DATA_DIR=./data
# DOWNLOAD_DIR=./downloads
WORKERS=2
MAX_QUEUE_SIZE=20
USER_COOLDOWN_SECONDS=15
MAX_FILE_MB=48
MAX_DURATION_SECONDS=1200
DOWNLOAD_TIMEOUT_SECONDS=180
# Faqat kerak bo'lsa, Netscape formatidagi cookies fayli yo'li.
COOKIES_FILE=
